# ==========================================
# My House - Git Ignore Configuration
# ==========================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# Environment Variables & Secrets (Keep .env.example tracked)
.env
*.env
!.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Python Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node.js & Frontend Dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production Build Artifacts
dist/
frontend/dist/
build/
*.tsbuildinfo

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# User Uploaded Static Files (preserve .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

